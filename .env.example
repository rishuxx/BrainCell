# === LLM Provider Keys (comma-separated, minimum 2) ===
LLM_API_KEYS=replace_key_1,replace_key_2

# === LLM Model (LiteLLM format) ===
LLM_MODEL=gemini/gemini-2.0-flash

# === Database ===
# Docker: sqlite:////data/app.db
# Local dev: sqlite:///./app.db
DATABASE_URL=sqlite:////data/app.db

# === CORS Allowed Origins (comma-separated) ===
ALLOWED_ORIGINS=http://localhost:3000

# === Failure Simulation (must be true on deployed backend for evaluation) ===
ENABLE_FAILURE_SIMULATION=true

# === Frontend API URL (Vite build-time variable) ===
VITE_API_BASE_URL=http://localhost:8000

# === Optional: LiteLLM timeout per provider call (seconds) ===
LLM_TIMEOUT=30

# === Optional: Default system prompt ===
DEFAULT_SYSTEM_PROMPT=You are a helpful AI assistant.
